# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Generated by `expo prebuild` (Continuous Native Generation): never edit by hand. Only the top-level
# folders (/android, /ios above): local modules keep their native source in modules/<name>/android.

# google-services.json is committed on purpose: it holds only public Firebase IDs, and builds
# need it for notifications. The private key (fcm-service-account.json) lives on the hub only.

# Local build log
build.log
